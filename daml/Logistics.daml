module Logistics where

import Daml.Script
import DA.Time
import DA.Date

data DisputeStatus
  = Open
  deriving (Eq, Show)

template ShipmentProposal
  with
    shipper : Party
    carrier : Party
    origin : Text
    destination : Text
    cargoType : Text
    weightKg : Decimal
    price : Decimal
    details : Text
    createdAt : Time
    currency : Optional Text
  where
    signatory shipper
    observer carrier

    ensure price > 0.0 && weightKg > 0.0

    choice Accept : ContractId Shipment
      controller carrier
      do
        create Shipment with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          price = price
          details = details
          createdAt = createdAt
          currency = currency

    choice Reject : ()
      controller carrier
      do
        return ()

template Shipment
  with
    shipper : Party
    carrier : Party
    origin : Text
    destination : Text
    cargoType : Text
    weightKg : Decimal
    price : Decimal
    details : Text
    createdAt : Time
    currency : Optional Text
  where
    signatory shipper, carrier

    choice CreateInvoice : ContractId Invoice
      controller carrier
      do
        create Invoice with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          amount = price
          details = details
          isPaid = False
          createdAt = createdAt
          currency = currency

template Invoice
  with
    shipper : Party
    carrier : Party
    origin : Text
    destination : Text
    cargoType : Text
    weightKg : Decimal
    amount : Decimal
    details : Text
    isPaid : Bool
    createdAt : Time
    currency : Optional Text
  where
    signatory carrier, shipper

    ensure amount > 0.0

    choice MarkPaid : ContractId Invoice
      controller shipper
      do
        assertMsg "Invoice is already paid" (not isPaid)
        create this with isPaid = True

    choice RaiseDispute : ContractId Dispute
      with
        reason : Text
        claimedAmount : Decimal
      controller shipper
      do
        assertMsg "Cannot dispute a paid invoice" (not isPaid)
        assertMsg "Claimed amount must be positive" (claimedAmount > 0.0)
        assertMsg "Claim cannot exceed invoice amount" (claimedAmount <= amount)
        now <- getTime
        create Dispute with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          originalAmount = amount
          claimedAmount = claimedAmount
          reason = reason
          status = Open
          createdAt = now
          currency = currency

template Dispute
  with
    shipper : Party
    carrier : Party
    origin : Text
    destination : Text
    cargoType : Text
    weightKg : Decimal
    originalAmount : Decimal
    claimedAmount : Decimal
    reason : Text
    status : DisputeStatus
    createdAt : Time
    currency : Optional Text
  where
    signatory shipper, carrier

    ensure originalAmount > 0.0 && claimedAmount > 0.0

    choice AcceptClaim : ContractId Invoice
      controller carrier
      do
        assertMsg "Dispute already resolved" (status == Open)
        now <- getTime
        create Invoice with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          amount = claimedAmount
          details = "Settlement after dispute: " <> reason
          isPaid = False
          createdAt = now
          currency = currency

    choice RejectClaim : ContractId Invoice
      controller carrier
      do
        assertMsg "Dispute already resolved" (status == Open)
        now <- getTime
        create Invoice with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          amount = originalAmount
          details = "Dispute rejected; original amount stands. Reason of dispute: " <> reason
          isPaid = False
          createdAt = now
          currency = currency

testLogistics = script do
  shipper <- allocateParty "Shipper"
  carrier <- allocateParty "Carrier"
  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Istanbul"
      destination = "Ankara"
      cargoType = "Electronics"
      weightKg = 800.0
      price = 5000.0
      details = "20ft Container - urgent"
      createdAt = (time (date 2026 May 1) 10 0 0)
      currency = Some "USD"
  shipmentId <- submit carrier do
    exerciseCmd proposalId Accept
  invoiceId <- submit carrier do
    exerciseCmd shipmentId CreateInvoice
  submit shipper do
    exerciseCmd invoiceId MarkPaid
  pure ()

testReject = script do
  shipper <- allocateParty "Shipper2"
  carrier <- allocateParty "Carrier2"
  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Izmir"
      destination = "Ankara"
      cargoType = "Hazardous"
      weightKg = 1200.0
      price = 8000.0
      details = "Reject scenario test"
      createdAt = (time (date 2026 May 1) 10 0 0)
      currency = Some "USD"
  submit carrier do
    exerciseCmd proposalId Reject
  pure ()

testDisputeAccepted = script do
  shipper <- allocateParty "Shipper3"
  carrier <- allocateParty "Carrier3"
  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Bursa"
      destination = "Antalya"
      cargoType = "Fragile glass"
      weightKg = 500.0
      price = 3000.0
      details = "Glass - dispute scenario"
      createdAt = (time (date 2026 May 1) 10 0 0)
      currency = Some "USD"
  shipmentId <- submit carrier do
    exerciseCmd proposalId Accept
  invoiceId <- submit carrier do
    exerciseCmd shipmentId CreateInvoice
  disputeId <- submit shipper do
    exerciseCmd invoiceId RaiseDispute with
      reason = "30% of glass items arrived broken"
      claimedAmount = 2100.0
  reducedInvoiceId <- submit carrier do
    exerciseCmd disputeId AcceptClaim
  submit shipper do
    exerciseCmd reducedInvoiceId MarkPaid
  pure ()

testDisputeRejected = script do
  shipper <- allocateParty "Shipper4"
  carrier <- allocateParty "Carrier4"
  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Adana"
      destination = "Izmir"
      cargoType = "Textiles"
      weightKg = 300.0
      price = 2000.0
      details = "Textile bundle"
      createdAt = (time (date 2026 May 1) 10 0 0)
      currency = Some "USD"
  shipmentId <- submit carrier do
    exerciseCmd proposalId Accept
  invoiceId <- submit carrier do
    exerciseCmd shipmentId CreateInvoice
  disputeId <- submit shipper do
    exerciseCmd invoiceId RaiseDispute with
      reason = "Late delivery"
      claimedAmount = 500.0
  reissuedInvoiceId <- submit carrier do
    exerciseCmd disputeId RejectClaim
  submit shipper do
    exerciseCmd reissuedInvoiceId MarkPaid

testEdgeCases = script do
  shipper <- allocateParty "Shipper5"
  carrier <- allocateParty "Carrier5"
  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Mersin"
      destination = "Konya"
      cargoType = "Edge case test"
      weightKg = 200.0
      price = 1500.0
      details = "Edge case scenarios"
      createdAt = (time (date 2026 May 1) 10 0 0)
      currency = Some "USD"
  shipmentId <- submit carrier do
    exerciseCmd proposalId Accept
  invoiceId <- submit carrier do
    exerciseCmd shipmentId CreateInvoice
  submitMustFail shipper do
    exerciseCmd invoiceId RaiseDispute with
      reason = "Trying to over-claim"
      claimedAmount = 9999.0
  submitMustFail shipper do
    exerciseCmd invoiceId RaiseDispute with
      reason = "Trying to claim zero"
      claimedAmount = 0.0
  paidInvoiceId <- submit shipper do
    exerciseCmd invoiceId MarkPaid
  submitMustFail shipper do
    exerciseCmd paidInvoiceId RaiseDispute with
      reason = "Trying to dispute a paid invoice"
      claimedAmount = 500.0
  submitMustFail shipper do
    exerciseCmd paidInvoiceId MarkPaid
  pure ()