module Logistics where

import Daml.Script

-- ═══════════════════════════════════════════════════════════
-- TYPES
-- ═══════════════════════════════════════════════════════════

data DisputeStatus
  = Open
  | Resolved
  deriving (Eq, Show)


-- ═══════════════════════════════════════════════════════════
-- SHIPMENT PROPOSAL
-- ═══════════════════════════════════════════════════════════

template ShipmentProposal
  with
    shipper : Party
    carrier : Party
    origin : Text
    destination : Text
    cargoType : Text
    weightKg : Decimal
    price : Decimal
    details : Text
  where
    signatory shipper
    observer carrier

    ensure price > 0.0 && weightKg > 0.0

    choice Accept : ContractId Shipment
      controller carrier
      do
        create Shipment with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          price = price
          details = details

    choice Reject : ()
      controller carrier
      do
        return ()


-- ═══════════════════════════════════════════════════════════
-- SHIPMENT
-- ═══════════════════════════════════════════════════════════

template Shipment
  with
    shipper : Party
    carrier : Party
    origin : Text
    destination : Text
    cargoType : Text
    weightKg : Decimal
    price : Decimal
    details : Text
  where
    signatory shipper, carrier

    choice CreateInvoice : ContractId Invoice
      controller carrier
      do
        create Invoice with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          amount = price
          details = details
          isPaid = False


-- ═══════════════════════════════════════════════════════════
-- INVOICE
-- ═══════════════════════════════════════════════════════════
-- Co-signed by both parties. Shipper marks paid OR raises a
-- Dispute if the delivery had an issue.
-- ═══════════════════════════════════════════════════════════

template Invoice
  with
    shipper : Party
    carrier : Party
    origin : Text
    destination : Text
    cargoType : Text
    weightKg : Decimal
    amount : Decimal
    details : Text
    isPaid : Bool
  where
    signatory carrier, shipper

    ensure amount > 0.0

    choice MarkPaid : ContractId Invoice
      controller shipper
      do
        assertMsg "Invoice is already paid" (not isPaid)
        create this with isPaid = True

    choice RaiseDispute : ContractId Dispute
      with
        reason : Text
        claimedAmount : Decimal
      controller shipper
      do
        assertMsg "Cannot dispute a paid invoice" (not isPaid)
        assertMsg "Claimed amount must be positive" (claimedAmount > 0.0)
        assertMsg "Claim cannot exceed invoice amount" (claimedAmount <= amount)
        create Dispute with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          originalAmount = amount
          claimedAmount = claimedAmount
          reason = reason
          status = Open


-- ═══════════════════════════════════════════════════════════
-- DISPUTE
-- ═══════════════════════════════════════════════════════════

template Dispute
  with
    shipper : Party
    carrier : Party
    origin : Text
    destination : Text
    cargoType : Text
    weightKg : Decimal
    originalAmount : Decimal
    claimedAmount : Decimal
    reason : Text
    status : DisputeStatus
  where
    signatory shipper, carrier

    ensure originalAmount > 0.0 && claimedAmount > 0.0

    -- Carrier accepts the dispute → create a NEW invoice with
    -- the reduced (claimed) amount. Shipper still has to pay it.
    choice AcceptClaim : ContractId Invoice
      controller carrier
      do
        assertMsg "Dispute already resolved" (status == Open)
        create Invoice with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          amount = claimedAmount
          details = "Settlement after dispute: " <> reason
          isPaid = False

    -- Carrier rejects the claim → reissue the original invoice.
    choice RejectClaim : ContractId Invoice
      controller carrier
      do
        assertMsg "Dispute already resolved" (status == Open)
        create Invoice with
          shipper = shipper
          carrier = carrier
          origin = origin
          destination = destination
          cargoType = cargoType
          weightKg = weightKg
          amount = originalAmount
          details = "Dispute rejected; original amount stands. Reason of dispute: " <> reason
          isPaid = False


-- ═══════════════════════════════════════════════════════════
-- TEST SCENARIOS
-- ═══════════════════════════════════════════════════════════

testLogistics = script do
  shipper <- allocateParty "Shipper"
  carrier <- allocateParty "Carrier"

  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Istanbul"
      destination = "Ankara"
      cargoType = "Electronics"
      weightKg = 800.0
      price = 5000.0
      details = "20ft Container - urgent"

  shipmentId <- submit carrier do
    exerciseCmd proposalId Accept

  invoiceId <- submit carrier do
    exerciseCmd shipmentId CreateInvoice

  submit shipper do
    exerciseCmd invoiceId MarkPaid

  pure ()

testReject = script do
  shipper <- allocateParty "Shipper2"
  carrier <- allocateParty "Carrier2"

  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Izmir"
      destination = "Ankara"
      cargoType = "Hazardous"
      weightKg = 1200.0
      price = 8000.0
      details = "Reject scenario test"

  submit carrier do
    exerciseCmd proposalId Reject

  pure ()

testDisputeAccepted = script do
  shipper <- allocateParty "Shipper3"
  carrier <- allocateParty "Carrier3"

  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Bursa"
      destination = "Antalya"
      cargoType = "Fragile glass"
      weightKg = 500.0
      price = 3000.0
      details = "Glass - dispute scenario"

  shipmentId <- submit carrier do
    exerciseCmd proposalId Accept

  invoiceId <- submit carrier do
    exerciseCmd shipmentId CreateInvoice

  -- Shipper raises a dispute claiming partial damage
  disputeId <- submit shipper do
    exerciseCmd invoiceId RaiseDispute with
      reason = "30% of glass items arrived broken"
      claimedAmount = 2100.0

  -- Carrier accepts the claim → reduced invoice
  reducedInvoiceId <- submit carrier do
    exerciseCmd disputeId AcceptClaim

  -- Shipper pays the reduced amount
  submit shipper do
    exerciseCmd reducedInvoiceId MarkPaid

  pure ()

testDisputeRejected = script do
  shipper <- allocateParty "Shipper4"
  carrier <- allocateParty "Carrier4"

  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Adana"
      destination = "Izmir"
      cargoType = "Textiles"
      weightKg = 300.0
      price = 2000.0
      details = "Textile bundle"

  shipmentId <- submit carrier do
    exerciseCmd proposalId Accept

  invoiceId <- submit carrier do
    exerciseCmd shipmentId CreateInvoice

  disputeId <- submit shipper do
    exerciseCmd invoiceId RaiseDispute with
      reason = "Late delivery"
      claimedAmount = 500.0

  -- Carrier rejects the claim → original invoice reissued
  reissuedInvoiceId <- submit carrier do
    exerciseCmd disputeId RejectClaim

  -- Shipper has to pay the original amount
  submit shipper do
    exerciseCmd reissuedInvoiceId MarkPaid

testEdgeCases = script do
  shipper <- allocateParty "Shipper5"
  carrier <- allocateParty "Carrier5"

  -- Setup: create a normal invoice
  proposalId <- submit shipper do
    createCmd ShipmentProposal with
      shipper = shipper
      carrier = carrier
      origin = "Mersin"
      destination = "Konya"
      cargoType = "Edge case test"
      weightKg = 200.0
      price = 1500.0
      details = "Edge case scenarios"

  shipmentId <- submit carrier do
    exerciseCmd proposalId Accept

  invoiceId <- submit carrier do
    exerciseCmd shipmentId CreateInvoice

  -- Edge case 1: Cannot claim more than the invoice amount
  submitMustFail shipper do
    exerciseCmd invoiceId RaiseDispute with
      reason = "Trying to over-claim"
      claimedAmount = 9999.0

  -- Edge case 2: Cannot claim a negative or zero amount
  submitMustFail shipper do
    exerciseCmd invoiceId RaiseDispute with
      reason = "Trying to claim zero"
      claimedAmount = 0.0

  -- Edge case 3: Pay the invoice, then try to dispute it
  paidInvoiceId <- submit shipper do
    exerciseCmd invoiceId MarkPaid

  submitMustFail shipper do
    exerciseCmd paidInvoiceId RaiseDispute with
      reason = "Trying to dispute a paid invoice"
      claimedAmount = 500.0

  -- Edge case 4: Cannot pay an already-paid invoice
  submitMustFail shipper do
    exerciseCmd paidInvoiceId MarkPaid

  pure ()