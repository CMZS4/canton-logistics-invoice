# ──────────────────────────────────────────────────────────────
# ChainFreight — environment configuration template
# Copy this file to .env (or .env.local) and adjust as needed.
# ──────────────────────────────────────────────────────────────

# Canton JSON Ledger API endpoint (the sandbox runs on 7575 by default)
VITE_LEDGER_API=http://localhost:7575

# Party hint prefixes — must match the partyIdHint used during
# party allocation (see Quick Start in README).
VITE_SHIPPER_HINT=Shipper
VITE_CARRIER_HINT=Carrier

# Display labels shown in the role selector.
VITE_SHIPPER_LABEL=Murat Logistics Inc.
VITE_CARRIER_LABEL=FastFreight Ltd.

# Polling interval for ledger refresh (milliseconds)
VITE_REFRESH_INTERVAL=3000